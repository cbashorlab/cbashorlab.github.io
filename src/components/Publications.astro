---
/**
 * @file Publications.astro
 * @description Renders an academic bibliography layout leveraging a retro pixel-art aesthetic.
 * Pulls, casts, and dynamically sorts academic text entries from local collections.
 * Leverages fixed dual-layered backdrops (sky/stars behind foreground city structures)
 * tied into an intersection tracker that safely hides assets when scrolled out of view.
 */

import { getCollection } from "astro:content";
import publicationsRaw from "../assets/content/publications.json";

/**
 * Purpose: Fetch raw data items from the local Markdown/MDX content collection.
 * Functionality: Uses Astro's built-in Content Layer API to query the 'publications' directory.
 */
const rawPubs = await getCollection("publications");

/**
 * Display order follows the entry order in publications.json directly (top of the
 * file = top of the list). Astro's content layer data store always persists entries
 * sorted alphabetically by id, so getCollection() alone can't recover file order —
 * the raw JSON is imported separately here just to read the original array position.
 */
const orderById = new Map(publicationsRaw.map((pub, index) => [pub.id, index]));
const pubs = rawPubs.sort((a, b) => (orderById.get(a.id) ?? 0) - (orderById.get(b.id) ?? 0));

/**
 * pub.data.url is a mix of site-relative asset paths ("/pdfs/x.pdf") and absolute
 * external links (publisher/DOI pages). Only relative paths need the BASE_URL prefix
 * for GitHub Pages sub-path serving — prefixing an absolute URL and slash-collapsing
 * it turns "https://doi.org/..." into a broken same-site path "/https:/doi.org/...".
 */
const isAbsoluteUrl = (url: string) => /^[a-z][a-z0-9+.-]*:\/\//i.test(url);
const resolvePubUrl = (url: string) =>
  isAbsoluteUrl(url) ? url : `${import.meta.env.BASE_URL}${url}`.replace(/\/+/g, "/");

/**
 * Asset Imports:
 * Purpose: Pull static visual files into the component bundle graph.
 * Functionality: Imports background imagery for the parallax stack and retro-themed 
 * iconography to act as hyperlinked download/view targets.
 */
import bg_stars from "../assets/publications/Pubs_Background_Houston_BACKGROUND.png";
import bg_city from "../assets/publications/Pubs_Background_Houston_FOREGROUND.png";
import pdf_icon from "../assets/publications/PDF.png";
import video_icon from "../assets/publications/VIDEO.png";
---

<div
  id="pubs-section"
  class="relative w-full min-h-[300svh] selection:bg-white selection:text-black bg-black pt-[100vh] px-8 md:px-20 min-h-screen flex flex-col items-center overflow-hidden"
>
  
  <div
    class="pubs-bg fixed inset-x-0 top-14 bottom-0 z-0 opacity-0 transition-opacity duration-700 pointer-events-none"
  >
    <img
      src={bg_stars.src}
      alt=""
      class="w-full h-full object-cover object-top image-rendering:pixelated"
    />
  </div>

  <div
    class="pubs-bg fixed inset-0 mx-auto max-w-[1920px] z-20 opacity-0 transition-opacity duration-700 pointer-events-none"
  >
    <img
      src={bg_city.src}
      alt=""
      class="w-full h-full object-cover object-bottom image-rendering:pixelated"
    />
  </div>

  <div class="relative z-10 w-full max-w-4xl mt-12">
    
    <h1
      id="publications-title"
      class="opacity-0 translate-y-6 transition-all duration-1000 ease-out will-change-[opacity,transform] text-white text-xl min-[375px]:text-3xl sm:text-3xl md:text-3xl lg:text-4xl mb-12 md:mb-16 tracking-tighter [text-shadow:2px_2px_0_#000] md:[text-shadow:4px_4px_0_#000] text-center w-full uppercase font-press-start-2p"
    >
      PUBLICATIONS
    </h1>
    
    <div class="space-y-12">
      {
        pubs.map((pub) => {
          return (
            <div class="pub-fade opacity-0 translate-y-6 transition-all duration-[400ms] cubic-bezier(0.25,1,0.5,1) will-change-[opacity,transform] flex flex-col space-y-3">
              <div class="flex flex-row items-start justify-between group gap-8">
                
                <div class="text-white text-2xl lg:text-3xl leading-[1.4] max-w-3xl font-orange-kid">
                  <span>{pub.data.authors} ({pub.data.year}). </span>
                  <span>{pub.data.title}. </span>
                  <span class="font-bold">{pub.data.journal}</span>
                  {pub.data.page && <span>. {pub.data.page}</span>}
                  <span>.</span>
                </div>

                <div class="flex flex-col gap-3 flex-shrink-0 pt-1">
                  
                  {/* Document Path Anchor Link Injection
                    Purpose: Directs users to the official hosted publication PDF.
                    Functionality: Checks for a valid URL, prepends Astro's subpath context
                    (`import.meta.env.BASE_URL`) for relative paths only, and safely opens
                    it in a blank tab.
                  */}
                  {pub.data.url && (
                    <a
                      href={resolvePubUrl(pub.data.url)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block transform transition-transform hover:scale-110 active:scale-95 cursor-pointer"
                    >
                      <img
                        src={pdf_icon.src}
                        alt="PDF"
                        class="w-8 md:w-10 h-auto image-rendering:pixelated"
                      />
                    </a>
                  )}

                  {/* Supporting Video File Links 
                    Purpose: Provides instant traversal to presentations or supplemental video files.
                    Functionality: Conditionally renders a pixel-art video camera link if `videoUrl` exists.
                  */}
                  {pub.data.videoUrl && (
                    <a
                      href={pub.data.videoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block transform transition-transform hover:scale-110 active:scale-95 cursor-pointer"
                    >
                      <img
                        src={video_icon.src}
                        alt="Video"
                        class="w-8 md:w-10 h-auto image-rendering:pixelated"
                      />
                    </a>
                  )}
                </div>
              </div>

              {/* Conditional Nested List: Sub-features, press mentions, or external highlight items 
                Purpose: Displays extra secondary context (e.g., "Featured in nature review", "Cover article").
                Functionality: Checks if a nested features array exists and contains elements, 
                then loops through them to build custom geometric bullet (`◇`) list nodes.
              */}
              {pub.data.features && pub.data.features.length > 0 && (
                <ul class="pl-4 md:pl-6 space-y-1 text-white text-xl lg:text-2xl font-orange-kid list-none">
                  {pub.data.features.map((feature) => (
                    <li class="flex items-start gap-2 text-gray-300">
                      <span class="text-white select-none">◇</span>
                      {feature.url ? (
                        <a
                          href={feature.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:text-white hover:underline transition-colors"
                        >
                          {feature.text}
                        </a>
                      ) : (
                        <span>{feature.text}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          );
        })
      }
    </div>

    <div class="mt-32 md:mt-48 text-center">
      <a
        href="https://pubmed.ncbi.nlm.nih.gov/?term=Bashor+CJ"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block border-4 border-white px-8 py-5 md:px-12 md:py-6 text-sm md:text-base lg:text-xl leading-relaxed text-white font-bold transform transition-transform hover:scale-105 hover:bg-white hover:text-black active:scale-95 font-press-start-2p"
      >
        Find more publications on PubMed
      </a>
    </div>
  </div>
</div>

<script>
  const section = document.getElementById("pubs-section");
  const backgrounds = document.querySelectorAll(".pubs-bg");

  /**
   * Performance Architecture Observation:
   * Purpose: Prevent performance degradation caused by fixed background elements rendering off-screen.
   * Functionality: Instantiates an `IntersectionObserver` that tracks visibility of the main wrapper. 
   * Strips/applies utility animation classes (`opacity-0` / `opacity-100`) to completely disable 
   * graphics compositing steps whenever the listing wraps outside the active viewport boundary.
   */
  if (section && backgrounds.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            backgrounds.forEach((bg) => {
              bg.classList.remove("opacity-0");
              bg.classList.add("opacity-100");
            });
          } else {
            backgrounds.forEach((bg) => {
              bg.classList.remove("opacity-100");
              bg.classList.add("opacity-0");
            });
          }
        });
      },
      // Only reveal the fixed publication backdrop once the Research section above
      // has completely scrolled out. The negative bottom rootMargin collapses the
      // observer root to a line at the very top of the viewport, so this fires the
      // instant this section's top edge (its void) reaches the top — i.e. when
      // Research is fully gone — so the cross-fade never overlaps the blue GIF.
      { threshold: 0, rootMargin: "0px 0px -100% 0px" },
    );

    observer.observe(section);
  }

  /**
   * Per-Citation Fade Observer:
   * Progressively fades each publication entry in as it enters the viewport and
   * back out as it is scrolled up and away, keeping the listing consistent with
   * the fade behavior used across the rest of the site.
   */
  const pubFades = document.querySelectorAll(".pub-fade");

  if (pubFades.length > 0) {
    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const ratio = entry.intersectionRatio;
          const target = entry.target as HTMLElement;

          if (ratio > 0.25) {
            target.style.opacity = "1";
            target.style.transform = "translateY(0px)";
          } else if (ratio > 0.05) {
            target.style.opacity = "0.4";
            target.style.transform = "translateY(3px)";
          } else {
            target.style.opacity = "0";
            target.style.transform = "translateY(24px)";
          }
        });
      },
      {
        rootMargin: "-8% 0px -8% 0px",
        threshold: [0, 0.05, 0.25, 0.5, 1.0],
      },
    );

    pubFades.forEach((el) => fadeObserver.observe(el));
  }
</script>

<script>
  /**
   * Section Title Fade-In:
   * Fades the "PUBLICATIONS" heading up into view the first time it appears.
   */
  const pubsTitle = document.getElementById("publications-title");
  if (pubsTitle) {
    const pubsTitleObserver = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-6");
            entry.target.classList.add("opacity-100", "translate-y-0");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );
    pubsTitleObserver.observe(pubsTitle);
  }
</script>

<style>
  /* Global Typography Anti-Aliasing Override:
    Purpose: Preserves the authentic low-fidelity look required by pixel-art mockups.
    Functionality: Disables OS-level font smoothing algorithms (`font-smooth: never`, `-webkit-font-smoothing`) 
    and forces sub-pixel alignment strategies across layout containers to ensure typography rasterizes 
    with crisp, hard geometric edges rather than smooth modern curves.
  */
  div,
  span,
  p,
  li {
    font-smooth: never;
    -webkit-font-smoothing: none;
    text-rendering: pixelated;
  }
</style>