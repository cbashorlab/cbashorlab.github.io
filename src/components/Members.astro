---
/**
 * @file GroupMembersList.astro
 * @description Renders a highly stylized team or laboratory roster from a local content collection.
 * Layout structures alternate symmetrically between mobile stack and horizontal alignments.
 * To integrate with long parallax or immersive scroll experiences, this section forces 
 * substantial structural vertical height (`min-h-[300svh]`) and includes massive 
 * transparent buffer zones to highlight the dynamic animated GIF background.
 */

import { getCollection } from "astro:content";
import bgImage from "../assets/members/animated-background.gif";
import membersData from "../assets/content/members.json";

/**
 * Data Fetching:
 * Resolves local file directories mapped to the 'members' collection layer.
 * Executing inside frontmatter blocks guarantees compilation strictly at site build time,
 * eliminating client-side data resolution penalties entirely.
 *
 * `getCollection()` does not guarantee it returns entries in the JSON array order,
 * so we sort the results to match the order in members.json — that file is the
 * single source of truth for how the roster is displayed.
 */
const memberOrder = new Map(membersData.map((m, index) => [m.id, index]));
const members = (await getCollection("members")).sort(
  (a, b) => (memberOrder.get(a.id) ?? 0) - (memberOrder.get(b.id) ?? 0),
);
---

<div class="min-h-[300svh] w-full pt-16 px-6 md:px-12 overflow-x-hidden">
    {/* Animated backdrop as a position:fixed, opacity-animated layer (NOT a CSS
        background) so it can cross-fade — the same technique the Publications
        backdrop uses. z-0 keeps it above the (non-positioned) next section, so it
        can dissolve over Contact, and below the z-10 content. */}
    <div class="members-bg fixed inset-0 z-0 opacity-0 transition-opacity duration-700 pointer-events-none">
        <img src={bgImage.src} alt="" class="w-full h-full object-cover object-center" />
    </div>

    {/* Content sits above the fixed backdrop. The empty 80vh buffer means the part
        of this section that scrolls into view first is transparent, so the previous
        (Publications) backdrop still cross-fades cleanly through it. */}
    <div class="relative z-10 w-full flex flex-col items-center">
        <div class="w-full h-[80vh] bg-transparent"></div>
    
    <h2
        id="members-title"
        class="opacity-0 translate-y-6 transition-all duration-1000 ease-out will-change-[opacity,transform] text-2xl md:text-3xl lg:text-4xl text-white mb-16 tracking-wider font-press-start-2p"
    >
        OUR GROUP
    </h2>

    <div class="w-full max-w-5xl flex flex-col gap-12">
        {
            /* Loop through all items inside the configured members schema metadata.
               Builds an individual, rows-based arrangement for every distinct record.
            */
            members.map((member) => (
                <div class="flex flex-col lg:flex-row items-center justify-between p-6 md:p-8 gap-6">
                    
                    <div class="flex-1 min-w-0 text-center break-words">
                        <h3 class="text-lg md:text-xl lg:text-2xl text-white mb-4 leading-relaxed font-press-start-2p">
                            {member.data.name}
                        </h3>
                        {/* whitespace-pre-line: a literal "\n" in the occupation
                            string (in members.json) renders as a line break, while
                            normal word-wrapping still applies. Expression is inlined
                            so the surrounding source whitespace isn't shown. */}
                        <p class="text-2xl md:text-3xl lg:text-4xl leading-relaxed max-w-md whitespace-pre-line font-orange-kid">{member.data.occupation}</p>
                    </div>

                    <div class="flex-shrink-0">
                        <div class="w-60 h-60 md:w-75 md:h-75 rounded-full overflow-hidden flex items-center justify-center ">
                            {/* Path Interpolation:
                                Safely appends base tracking parameters (`BASE_URL`) to paths.
                                Crucial if application instances are served under distinct project sub-directories.
                            */}
                            <img
                                src={`${import.meta.env.BASE_URL}${member.data.avatar}`.replace(/\/+/g, '/')}
                                alt={member.data.name}
                                class="w-full h-full object-cover"
                            />
                        </div>
                    </div>

                    <div class="flex-1 min-w-0 text-center break-words">
                        {/* whitespace-pre-line: a literal "\n" in the distinction
                            string (in members.json) renders as a line break. */}
                        <p class="text-2xl md:text-3xl lg:text-4xl leading-relaxed max-w-md mx-auto lg:ml-auto lg:mr-0 whitespace-pre-line font-orange-kid">{member.data.distinction}</p>
                    </div>
                </div>
            ))
        }
    </div>

    <a
        href={`${import.meta.env.BASE_URL}/alumnipage`.replace(/\/+/g, '/')}
        class="mt-20 inline-block border-4 border-white bg-black/60 px-8 py-5 md:px-12 md:py-6 text-sm md:text-base lg:text-xl leading-relaxed text-white text-center transform transition-transform hover:scale-105 hover:bg-white hover:text-black active:scale-95 font-press-start-2p"
    >
        Meet our Alumni
    </a>

    </div>
</div>

<script>
  /**
   * Section Title Fade-In:
   * Fades the "OUR GROUP" heading up into view the first time it enters the viewport.
   */
  const membersTitle = document.getElementById("members-title");
  if (membersTitle) {
    const membersTitleObserver = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-6");
            entry.target.classList.add("opacity-100", "translate-y-0");
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );
    membersTitleObserver.observe(membersTitle);
  }

  /**
   * Background Dissolve Observer:
   * The animated backdrop is a position:fixed layer (see markup) rather than a CSS
   * background, so it can cross-fade. It stays visible while this section overlaps the
   * top edge of the viewport, and fades out the instant the section's bottom passes
   * the top — i.e. once the next section (Contact) has fully scrolled into place — so
   * the backdrop dissolves over it. This mirrors the Publications backdrop, giving the
   * Members → Contact hand-off the same seamless cross-fade as Publications → Members.
   */
  const membersSection = document.getElementById("members");
  const membersBackgrounds = document.querySelectorAll(".members-bg");
  if (membersSection && membersBackgrounds.length > 0) {
    const bgObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          membersBackgrounds.forEach((bg) => {
            bg.classList.toggle("opacity-0", !entry.isIntersecting);
            bg.classList.toggle("opacity-100", entry.isIntersecting);
          });
        });
      },
      { threshold: 0, rootMargin: "0px 0px -100% 0px" },
    );
    bgObserver.observe(membersSection);
  }
</script>