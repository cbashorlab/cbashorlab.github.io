---
/**
 * @file Navigation.astro
 * @description Header navigation bar featuring a retro-gaming 8-bit aesthetic. 
 * Includes an automated typewriter effect for the lab title, a responsive dropdown 
 * menu driven by UI overlay click rules, and adaptive layout visibility breakpoints 
 * for embedded project social shortcuts.
 */

import hamburgerIcon from "../assets/nav/hambuger_menu.png";
import dropdownBg from "../assets/nav/dropdown_background.png";
import instaIcon from "../assets/nav/insta_icon.png";
import githubIcon from "../assets/nav/github_cat.png";
import xIcon from "../assets/nav/x_logo.png";

/**
 * Site Navigation Anchors:
 * Array containing internal element anchors and absolute page routings.
 * Dynamically prefixes base configurations via `import.meta.env.BASE_URL` 
 * to remain decoupled from target subdirectory structures.
 */
// Section anchors are prefixed with the home path (not bare "#..." hashes) so
// they still navigate back to the right section when clicked from /alumnipage.
const withBase = (path: string) => `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, '/');

const navLinks = [
  { name: "Home", url: withBase("") },
  { name: "About Us", url: withBase("#about") },
  { name: "Research", url: withBase("#research") },
  { name: "Publications", url: withBase("#publications") },
  { name: "Roster", url: withBase("#members") },
  { name: "Alumni", url: withBase("alumnipage") },
  { name: "Contact", url: withBase("#contact") },
];

/**
 * External Social Media Portals:
 * Maps assets and target paths out to the project's online profile destinations.
 */
const socialLinks = [
  {
    name: "IG",
    url: "https://www.instagram.com/bashor_lab/",
    icon: instaIcon.src,
  },
  { name: "GH", url: "https://github.com/cbashorlab", icon: githubIcon.src },
  { name: "X", url: "https://x.com/BashorLab", icon: xIcon.src },
];
---

<nav
  class="sticky top-0 z-[100] border-b-4 border-zinc-900 bg-black px-4 py-4 md:py-2 md:px-10 font-press-start-2p"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 sm:gap-6 md:gap-8">

    <div class="overflow-hidden min-w-0">
      <h1
        id="title-line"
        class="text-[9px] sm:text-sm md:text-base lg:text-2xl xl:text-3xl text-white leading-tight md:leading-none tracking-tight"
      ><span id="typewriter"></span><span
          id="cursor"
          class="inline-block align-middle ml-1 md:ml-2 h-2.5 w-1.5 sm:h-4 sm:w-3 md:h-8 md:w-4 bg-white"
        ></span></h1>
    </div>

    <div class="relative flex items-center gap-2.5 sm:gap-5 md:gap-6 shrink-0 z-[110]">

      <div class="flex items-center gap-2.5 sm:gap-4 md:gap-5">
        {
          socialLinks.map((social) => (
            <a
              href={social.url}
              class="transition-transform hover:-translate-y-1"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src={social.icon} alt={social.name} class="w-6 sm:w-8 lg:w-12" />
            </a>
          ))
        }
      </div>

      <button
        id="menu-toggle"
        class="relative z-[120] transition-opacity active:opacity-50 transition-transform hover:-translate-y-1 focus:outline-none"
        aria-label="Toggle Menu"
      >
        <img
          src={hamburgerIcon.src}
          alt="Menu"
          class="w-7 sm:w-10 md:w-14"
        />
      </button>

      <div
        id="mobile-menu"
        class="hidden absolute right-0 top-[140%] z-[110] w-64 sm:w-72 p-6 sm:p-8 shadow-2xl rounded-sm"
        style={`background-image: url(${dropdownBg.src}); background-size: 100% 100%; image-rendering: pixelated;`}
      >
        <ul
          class="flex flex-col gap-5 sm:gap-6 text-center text-xs sm:text-sm md:text-lg text-black font-medium"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.url}
                  class="hover:underline decoration-2 mobile-nav-link"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</nav>

<script>
  // Character Assembly Configurations
  const text = "WELCOME TO THE BASHOR LAB";
  const container = document.getElementById("typewriter");
  let charIndex = 0;

  /**
   * Typewriter Animation Framework:
   * Progressively appends substrings to target text elements at fixed 80ms increments.
   */
  function typeEffect() {
    if (container && charIndex < text.length) {
      container.textContent += text.charAt(charIndex);
      charIndex++;
      setTimeout(typeEffect, 80);
    }
  }

  // Dropdown Element Selection Framework
  const menuBtn = document.getElementById("menu-toggle");
  const menuDropdown = document.getElementById("mobile-menu");
  const navLinks = document.querySelectorAll(".mobile-nav-link");

  /**
   * Menu Toggle Handler:
   * Controls drawer visibility states. `stopPropagation()` stops event pooling 
   * from hitting global root body contexts, preventing immediate closure loops.
   */
  menuBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    menuDropdown?.classList.toggle("hidden");
  });

  /**
   * Drawer Content Link Selection Tracker:
   * Forces a dropdown close event when a user selects internal relative anchors, 
   * updating view positions without locking modal curtains over the screen viewport.
   */
  navLinks.forEach(link => {
    link.addEventListener("click", () => {
      menuDropdown?.classList.add("hidden");
    });
  });

  /**
   * Outside Context Click Controller:
   * Tracks clicks across the document context to automatically fold up open navigation drawers 
   * if user clicks outside of the menu overlay boundaries.
   */
  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (menuDropdown && !menuDropdown.contains(target) && !menuBtn?.contains(target)) {
      menuDropdown.classList.add("hidden");
    }
  });

  // Launch text entry cycle processing upon completion of initial DOM structures
  window.addEventListener("DOMContentLoaded", typeEffect);
</script>

<style>
  /* Intermittent blinking emulation mapping a hardware-like terminal line pointer */
  #cursor {
    animation: blink 0.8s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* The title text and its trailing block cursor share one inline flow inside
     #title-line so the cursor always sits immediately after the last typed
     character. The text wraps at word boundaries so the full
     "WELCOME TO THE BASHOR LAB" is always shown rather than being clipped when it
     can't fit on one line (e.g. at tablet widths, where Press Start 2P is too wide
     for a single line next to the social icons). It stays on one line whenever it
     fits; `overflow-wrap: break-word` is a fallback for very narrow screens. */
  #title-line {
    white-space: normal;
    overflow-wrap: break-word;
  }

  /* Overrides basic image interpolation routines to retain pixel-art edge crispness */
  img {
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  /* Hardware acceleration hint forcing elements safely to distinct GPU compositing targets */
  nav {
    transform: translateZ(0);
    will-change: transform;
  }
</style>